<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>OBD Pro Ultimate System</title>
<!-- Подключаем Chart.js для графиков -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
--bg:#f4f5f7;--card:#fff;--text:#14171c;--muted:#6b7280;--accent:#1c69d4;--danger:#c62828;--warning:#f57c00;--line:#e3e5e9}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f1115;--card:#1a1d23;--text:#eceff4;--muted:#9aa3b2;--accent:#5b9dff;--danger:#ef6b6b;--warning:#ffb74d;--line:#2a2e36}}
:root[data-theme="dark"]{--bg:#0f1115;--card:#1a1d23;--text:#eceff4;--muted:#9aa3b2;--accent:#5b9dff;--danger:#ef6b6b;--warning:#ffb74d;--line:#2a2e36}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--text);font:16px/1.4 -apple-system,system-ui,"Segoe UI",Roboto,sans-serif}
main{max-width:640px;margin:0 auto;padding:16px}
h1{font-size:22px;margin:0 0 4px}
#status{color:var(--muted);font-size:14px;min-height:20px;margin-bottom:12px}
.row{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px;align-items:center}
button, select{font:inherit;border:0;border-radius:10px;padding:10px 14px;background:var(--accent);color:#fff;cursor:pointer}
button.sec, select.sec{background:var(--card);color:var(--text);border:1px solid var(--line)}
button.danger{background:var(--danger)}
button.warning{background:var(--warning);color:#fff}
button.demo{background:#2e7d32;color:#fff}
button:disabled, select:disabled{opacity:.4}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:10px 12px;cursor:pointer;position:relative;transition:background 0.3s, border-color 0.3s}
.card.warn{border-color:var(--warning);background:rgba(245,124,0,0.1)}
.card.alarm{border-color:var(--danger);background:rgba(198,40,40,0.2);animation:pulse 1s infinite alternate}
@keyframes pulse { from { opacity: 1; } to { opacity: 0.7; } }
.card small{display:block;color:var(--muted);font-size:12px}
.card b{font-size:22px;font-variant-numeric:tabular-nums}
.card span{color:var(--muted);font-size:13px;margin-left:4px}
.card .hint{font-size:10px;color:var(--accent);display:block;margin-top:2px}
h2{font-size:16px;margin:18px 0 8px}
#dtc div{font-family:ui-monospace,Menlo,monospace;padding:6px 0;border-bottom:1px solid var(--line)}
details{margin-top:18px}
a{color:var(--accent)}
input:not([type=checkbox]){font:inherit;border:1px solid var(--line);border-radius:10px;padding:10px;background:var(--card);color:var(--text);flex:1;min-width:0}
.mod{display:flex;flex-wrap:wrap;gap:6px;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid var(--line);font-family:ui-monospace,Menlo,monospace}
#udsOut,#tOut{white-space:pre-wrap;word-break:break-all;font:12px ui-monospace,Menlo,monospace;margin-top:8px}
#devLog{white-space:pre-wrap;word-break:break-all;font:11px ui-monospace,Menlo,monospace;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:8px;max-height:200px;overflow:auto;color:#d32f2f}
@media (prefers-color-scheme:dark){#devLog{color:#ff8a80}}

/* Модальное окно графика */
#modal{display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.6);z-index:100;justify-content:center;align-items:center;padding:16px;box-sizing:border-box}
#modalContent{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px;width:100%;max-width:600px;box-shadow:0 4px 20px rgba(0,0,0,0.3)}
</style>
</head>
<body>
<main>
<h1>OBD Pro Ultimate</h1>
<div id="status">Выберите профиль и нажмите «Подключить» или «Демо-режим».</div>

<div class="row">
  <select id="profileSel" class="sec">
    <option value="bmw">Профиль: BMW E46 / Diesel</option>
    <option value="universal" selected>Профиль: Universal CAN</option>
    <option value="vag">Профиль: VAG Group</option>
  </select>
  <label style="font-size:13px;display:flex;align-items:center;gap:4px">
    <input type="checkbox" id="chkAudio" checked> Звуковые алерты
  </label>
</div>

<div class="row">
  <button id="bConn">Подключить адаптер</button>
  <button id="bDemo" class="demo">Демо-режим</button>
  <button id="bStop" class="sec" disabled>Остановить</button>
  <button id="bMarker" class="warning" disabled>Поставить маркер</button>
  <button id="bLog" class="sec">Сохранить лог</button>
  <button id="bCsv" class="sec" disabled>CSV Лог</button>
</div>

<div class="grid" id="grid"></div>

<details><summary>Выбор параметров и нормы ХХ</summary><div id="pick"></div></details>

<h2>Ошибки (DTC)</h2>
<div class="row">
  <button id="bRead" class="sec" disabled>Прочитать коды</button>
  <button id="bClear" class="danger" disabled>Стереть коды</button>
</div>
<div id="dtc"></div>

<h2>Блоки (CAN/UDS)</h2>
<div class="row"><button id="bScan" class="sec" disabled>Найти блоки</button></div>
<div id="mods"></div>
<div id="udsOut"></div>

<h2>Терминал</h2>
<div class="row"><input id="tIn" placeholder="ATDP или 0100" autocapitalize="characters" autocomplete="off"><button id="tSend" class="sec" disabled>Отправить</button></div>
<div id="tOut"></div>

<details open><summary>Лог разработчика (отладка)</summary><pre id="devLog"></pre></details>
</main>

<!-- Модальное окно графика -->
<div id="modal">
  <div id="modalContent">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
      <h3 id="modalTitle" style="margin:0;font-size:16px">График</h3>
      <button class="sec" id="bCloseModal" style="padding:4px 10px">Закрыть</button>
    </div>
    <div style="position:relative;height:250px;"><canvas id="chartCanvas"></canvas></div>
  </div>
</div>

<script>
(() => {
const $ = s => document.querySelector(s);
const sleep = ms => new Promise(r => setTimeout(r, ms));

let logBuf = '';
let csvBuf = 'Timestamp;Parameter;Value;Unit;Marker\n';
let recordingCsv = false;
let chartInstance = null;
let activeChartMetric = null;
let chartDataHistory = {};
let isDemoMode = false;
let audioCtx = null;

// Аудио-оповещение (сигнал тревоги)
function playAlarmSound() {
  if (!$('#chkAudio').checked) return;
  try {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(880, audioCtx.currentTime); // Тон A5
    gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start();
    osc.stop(audioCtx.currentTime + 0.3);
    if (navigator.vibrate) navigator.vibrate([200, 100, 200]);
  } catch (e) {}
}

// Лог разработчика с таймстампами
const devLog = (msg, isErr = false) => {
  const time = new Date().toISOString().split('T')[1].slice(0, 12);
  const line = `[${time}] ${isErr ? '⚠ ERROR: ' : ''}${msg}\n`;
  logBuf += line;
  const box = $('#devLog');
  if (box) {
    box.textContent += line;
    box.scrollTop = box.scrollHeight;
  }
};

async function saveLog() {
  const f = new File([logBuf], 'obd-dev-debug.txt', {type: 'text/plain'});
  try { if (navigator.canShare && navigator.canShare({files: [f]})) { await navigator.share({files: [f]}); return; } } catch (e) {}
  const a = document.createElement('a'); a.href = URL.createObjectURL(f); a.download = 'obd-dev-debug.txt'; a.click();
}

async function saveCsv() {
  const f = new File([csvBuf], 'obd-data-log.csv', {type: 'text/csv'});
  try { if (navigator.canShare && navigator.canShare({files: [f]})) { await navigator.share({files: [f]}); return; } } catch (e) {}
  const a = document.createElement('a'); a.href = URL.createObjectURL(f); a.download = 'obd-data-log.csv'; a.click();
}

const status = m => { $('#status').textContent = m; };
const errText = e => (e && (e.name || e.message)) ? ((e.name || '') + ': ' + (e.message || '')) : 'неизвестная ошибка (' + String(e) + ')';

// Структура метрик с диапазонами аварий (minWarn, maxWarn, minAlarm, maxAlarm)
const M = (pid, t, u, f, k, norm, limits) => ({
  pid, t, u, f, k: k || String(pid), norm: norm || '—', limits: limits || {}
});

const w = (b, i) => b[i] * 256 + b[i + 1];
const s16 = (b, i) => { const v = w(b, i); return v > 32767 ? v - 65536 : v; };

const METRICS = [
  M(0x04, 'Нагрузка двигателя', '%', b => b[0] * 100 / 255, '4', 'ХХ: 20-35%', {maxWarn:85, maxAlarm:98}),
  M(0x05, 'Температура ОЖ', '°C', b => b[0] - 40, '5', 'Рабочая: 85-95°C', {maxWarn:98, maxAlarm:105, minWarn:60}),
  M(0x0B, 'Давление во впуске (MAP)', 'кПа', b => b[0], '11', 'ХХ: ~95-105 кПа', {maxWarn:220, maxAlarm:250}),
  M(0x0C, 'Обороты двигателя', 'об/мин', b => w(b, 0) / 4, '12', 'ХХ: 750-830 об/мин', {maxWarn:4200, maxAlarm:4800}),
  M(0x0D, 'Скорость', 'км/ч', b => b[0], '13', '0 км/ч'),
  M(0x0E, 'Угол опережения', '°', b => b[0] / 2 - 64, '14', 'ХХ: 3-8°'),
  M(0x0F, 'Темп. воздуха на впуске', '°C', b => b[0] - 40, '15', 'Зависит от погоды', {maxWarn:65, maxAlarm:75}),
  M(0x10, 'Расход воздуха (MAF)', 'г/с', b => w(b, 0) / 100, '16', 'ХХ: 10-25 г/с'),
  M(0x11, 'Положение дросселя', '%', b => b[0] * 100 / 255, '17', 'ХХ: 0%'),
  M(0x23, 'Давление в рампе', 'кПа', b => w(b, 0) * 10, '35', 'ХХ: 250-350 бар'),
  M(0x33, 'Атмосферное давление', 'кПа', b => b[0], '51', 'Норма: ~100 кПа'),
  M(0x42, 'Напряжение бортсети', 'В', b => w(b, 0) / 1000, '66', 'ХХ: 13.8 - 14.4 В', {minWarn:12.2, minAlarm:11.6, maxWarn:14.8, maxAlarm:15.5}),
  M(0x5C, 'Температура масла', '°C', b => b[0] - 40, '92', 'Рабочая: 90-105°C', {maxWarn:110, maxAlarm:125}),
  M(0x5E, 'Расход топлива', 'л/ч', b => w(b, 0) / 20, '94', 'ХХ: 0.6 - 1.2 л/ч')
];

const U = h => '0000' + h + '-0000-1000-8000-00805f9b34fb';
const SERVICES = [U('fff0'), U('ffe0'), U('ffe5'), U('18f0'), 'e7810a71-73ae-499d-8c15-faa9aef0c3f2', '49535343-fe7d-4ae5-8fa9-9fafd205e455'];

let wch = null, nch = null, buf = '', pending = null, running = false, action = null, active = [], avail = [];
let sel = new Set(['4', '5', '11', '12', '13', '16', '66', '92']);
let unitConversions = {};
let currentMarker = '';

try { const j = JSON.parse(localStorage.getItem('sel')); if (Array.isArray(j)) sel = new Set(j); } catch (e) {}

function refresh() { active = avail.filter(m => sel.has(m.k)); render(); }

function pickUI() {
  const b = $('#pick'); b.innerHTML = '';
  avail.forEach(m => {
    const l = document.createElement('label'); l.style.display = 'block'; l.style.padding = '4px 0'; l.style.fontSize = '14px';
    const c = document.createElement('input'); c.type = 'checkbox'; c.checked = sel.has(m.k);
    c.onchange = () => { if (c.checked) sel.add(m.k); else sel.delete(m.k); try { localStorage.setItem('sel', JSON.stringify([...sel])); } catch (e) {} refresh(); };
    l.append(c, ` ${m.t} (${m.u}) — `);
    const spanNorm = document.createElement('span'); spanNorm.style.color = 'var(--muted)'; spanNorm.textContent = m.norm;
    l.appendChild(spanNorm);
    b.appendChild(l);
  });
}

function onData(e) {
  buf += new TextDecoder().decode(e.target.value);
  if (buf.includes('>') && pending) {
    const p = pending; pending = null; clearTimeout(p.t);
    const lines = buf.replace(/>/g, '').split(/[\r\n]+/).map(s => s.trim()).filter(Boolean);
    buf = '';
    devLog('< ' + lines.join(' | '));
    p.res(lines);
  }
}

function send(cmd, to = 5000) {
  return new Promise((res, rej) => {
    if (isDemoMode) { res(['41 00 OK']); return; }
    buf = '';
    const t = setTimeout(() => { 
      pending = null; 
      devLog('Таймаут ответа: ' + cmd, true);
      rej(new Error('нет ответа на ' + cmd)); 
    }, to);
    pending = {res, t};
    const d = new TextEncoder().encode(cmd + '\r');
    devLog('> ' + cmd);
    const w = wch.properties.writeWithoutResponse ? wch.writeValueWithoutResponse(d) : wch.writeValue(d);
    w.catch(e => { clearTimeout(t); pending = null; devLog('Ошибка BLE: ' + errText(e), true); rej(e); });
  });
}

async function bytes(pid, to = 5000) {
  if (isDemoMode) {
    await sleep(35);
    if (pid === 0x0C) return [Math.floor(750 + Math.random() * 60) / 4 >> 8, (750 + Math.random() * 60) * 4 & 255];
    if (pid === 0x05) return [92 + 40];
    if (pid === 0x42) return [0x3B, 0x10];
    if (pid === 0x0B) return [101];
    if (pid === 0x10) return [0x05, 0xDC];
    if (pid === 0x5C) return [96 + 40];
    return [Math.floor(Math.random() * 100), Math.floor(Math.random() * 100)];
  }

  const h2 = pid.toString(16).padStart(2, '0').toUpperCase();
  const h = hexBody(await send('01' + h2, to));
  const i = h.indexOf('41' + h2);
  return i < 0 ? null : (h.slice(i + 4).match(/../g) || []).map(v => parseInt(v, 16));
}

async function supported() {
  if (isDemoMode) return new Set([0x04, 0x05, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F, 0x10, 0x11, 0x23, 0x33, 0x42, 0x5C, 0x5E]);
  const s = new Set(); let base = 0;
  while (true) {
    const b = await bytes(base, 8000);
    if (!b || b.length < 4) break;
    for (let i = 0; i < 32; i++) if (b[i >> 3] & (0x80 >> (i & 7))) s.add(base + i + 1);
    if (!s.has(base + 0x20) || base >= 0x60) break;
    base += 0x20;
  }
  return s;
}

// Расширенная встроенная офлайн-база кодов ошибок
const DTC_DATABASE = {
  P0087: 'Низкое давление в топливной рампе (Common Rail)',
  P0088: 'Слишком высокое давление в топливной рампе',
  P0100: 'Неисправность цепи датчика расхода воздуха (MAF)',
  P0101: 'Выход сигнала MAF из допустимого диапазона',
  P0105: 'Неисправность цепи датчика давления во впуске (MAP)',
  P0115: 'Неисправность цепи датчика температуры ОЖ',
  P0171: 'Слишком бедная смесь (Bank 1)',
  P0172: 'Слишком богатая смесь (Bank 1)',
  P0234: 'Избыточное давление наддува (Передув турбины)',
  P0299: 'Недостаточное давление наддува (Недодув турбины)',
  P0300: 'Обнаружены пропуски зажигания (многоцилиндровые)',
  P0335: 'Ошибка сигнала датчика положения коленвала (CKP)',
  P0340: 'Ошибка сигнала датчика положения распредвала (CMP)',
  P0380: 'Неисправность в цепи свечей накала / реле накала',
  P0401: 'Система EGR: недостаточный рециркуляционный поток',
  P0402: 'Система EGR: избыточный поток рециркуляции газов',
  P0562: 'Низкое напряжение бортовой сети автомобиля',
  P2002: 'Эффективность сажевого фильтра DPF ниже порога'
};

function describe(c) { return DTC_DATABASE[c] || 'Код неисправности стандарта OBD-II'; }

function dtcRow(c, x) {
  const d = document.createElement('div');
  d.textContent = c + (x ? ' [' + x + ']' : '') + ' — ' + describe(c.slice(0, 5)) + ' ';
  const a = document.createElement('a');
  a.textContent = 'искать'; a.target = '_blank'; a.rel = 'noopener';
  a.href = 'https://www.google.com/search?q=' + encodeURIComponent(c.slice(0, 5) + ' ошибка BMW');
  d.appendChild(a);
  return d;
}

function decodeDTC(h) {
  if (h.length !== 4 || h === '0000') return null;
  const v = parseInt(h, 16);
  return 'PCBU'[v >> 14] + ((v >> 12) & 3) + (v & 0xFFF).toString(16).toUpperCase().padStart(3, '0');
}

async function readDTC() {
  if (isDemoMode) {
    const box = $('#dtc'); box.innerHTML = '';
    box.appendChild(dtcRow('P0299'));
    devLog('Демо-режим: прочитан тест-код P0299 (Недодув)');
    return;
  }
  const out = new Set();
  for (const l of await send('03', 10000)) {
    let h = l.replace(/\s/g, '');
    if (!h.startsWith('43')) continue;
    h = h.slice(2);
    if (h.length % 4 === 2) h = h.slice(2);
    for (let i = 0; i + 4 <= h.length; i += 4) { const c = decodeDTC(h.substr(i, 4)); if (c) out.add(c); }
  }
  const box = $('#dtc'); box.innerHTML = '';
  if (!out.size) box.textContent = 'Ошибок нет';
  [...out].sort().forEach(c => box.appendChild(dtcRow(c)));
}

function hexBody(lines) {
  let h = '';
  for (let l of lines) {
    l = l.replace(/\s/g, '');
    if (!/^([0-9A-F]:)?[0-9A-F]+$/.test(l) || /^[0-9A-F]{3}$/.test(l)) continue;
    h += l.replace(/^[0-9A-F]:/, '');
  }
  return h;
}

function buttons() {
  const activeState = running || isDemoMode;
  $('#bScan').disabled = !activeState;
  $('#tSend').disabled = !activeState;
  $('#bConn').disabled = running || isDemoMode;
  $('#bDemo').disabled = running || isDemoMode;
  $('#bStop').disabled = !activeState;
  $('#bRead').disabled = !activeState;
  $('#bClear').disabled = !activeState;
  $('#bCsv').disabled = !activeState;
  $('#bMarker').disabled = !activeState;
}

function render() {
  const g = $('#grid'); g.innerHTML = '';
  active.forEach(m => {
    const c = document.createElement('div'); c.className = 'card';
    c.id = 'card-' + m.k;
    let unitLabel = m.u;
    if (unitConversions[m.k] && m.u === 'кПа') unitLabel = 'бар';
    
    c.innerHTML = `<small>${m.t}</small><b id="v${m.k}">—</b> <span id="u${m.k}">${unitLabel}</span><small class="hint">клик для графика / ед.</small>`;
    
    c.onclick = () => {
      if (m.u === 'кПа') {
        unitConversions[m.k] = !unitConversions[m.k];
        refresh();
        return;
      }
      openChart(m);
    };
    g.appendChild(c);
  });
}

function openChart(m) {
  activeChartMetric = m;
  $('#modalTitle').textContent = `График: ${m.t} (${unitConversions[m.k] && m.u === 'кПа' ? 'бар' : m.u})`;
  $('#modal').style.display = 'flex';

  const ctx = $('#chartCanvas').getContext('2d');
  const history = chartDataHistory[m.k] || {labels: [], data: []};

  if (chartInstance) chartInstance.destroy();

  chartInstance = new Chart(ctx, {
    type: 'line',
    data: {
      labels: history.labels,
      datasets: [{
        label: m.t,
        data: history.data,
        borderColor: '#1c69d4',
        backgroundColor: 'rgba(28, 105, 212, 0.1)',
        borderWidth: 2,
        fill: true,
        tension: 0.2
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        y: { ticks: { color: 'var(--text)' }, grid: { color: 'var(--line)' } },
        x: { ticks: { color: 'var(--text)', maxTicksLimit: 6 }, grid: { color: 'var(--line)' } }
      }
    }
  });
}

$('#bCloseModal').onclick = () => {
  $('#modal').style.display = 'none';
  if (chartInstance) chartInstance.destroy();
  activeChartMetric = null;
};

// Проверка выходов за границы нормы (Алерт система)
function checkMetricLimits(m, val) {
  const card = $('#card-' + m.k);
  if (!card) return;
  const lim = m.limits;
  let state = 'normal';

  if ((lim.maxAlarm && val >= lim.maxAlarm) || (lim.minAlarm && val <= lim.minAlarm)) {
    state = 'alarm';
  } else if ((lim.maxWarn && val >= lim.maxWarn) || (lim.minWarn && val <= lim.minWarn)) {
    state = 'warn';
  }

  card.classList.remove('warn', 'alarm');
  if (state === 'alarm') {
    card.classList.add('alarm');
    playAlarmSound();
  } else if (state === 'warn') {
    card.classList.add('warn');
  }
}

async function runMainLoop() {
  running = true; buttons();
  recordingCsv = true;
  try {
    try { await navigator.wakeLock?.request('screen'); } catch (e) {}
    devLog(isDemoMode ? 'Запуск симулятора...' : 'Инициализация адаптера...');
    status(isDemoMode ? 'Режим симуляции активен' : 'Инициализация адаптера…');
    
    if (!isDemoMode) {
      for (const c of ['ATZ', 'ATE0', 'ATL0', 'ATS0', 'ATH0', 'ATAT1', 'ATSP0']) await send(c, c === 'ATZ' ? 6000 : 3000);
      status('Опрос поддерживаемых PID...');
    }

    const sup = await supported();
    if (!sup.size) { throw new Error('ЭБУ не ответил ни на один PID запрос.'); }
    
    avail = METRICS.filter(m => sup.has(m.pid)); 
    pickUI(); 
    refresh();
    status(isDemoMode ? 'Демо-режим активен' : 'Опрос параметров...');

    while (running) {
      const pidsToQuery = [...new Set(active.map(m => m.pid))];
      for (const pid of pidsToQuery) {
        if (!running) break;
        const b = await bytes(pid, 2000);
        if (b && b.length) {
          active.filter(m => m.pid === pid).forEach(m => {
            try {
              let v = m.f(b);
              if (isFinite(v)) {
                let displayValue = v;
                if (unitConversions[m.k] && m.u === 'кПа') displayValue = v / 100;
                
                const el = $('#v' + m.k);
                if (el) el.textContent = displayValue.toFixed(1);

                // Проверка тревог
                checkMetricLimits(m, v);

                if (!chartDataHistory[m.k]) chartDataHistory[m.k] = {labels: [], data: []};
                const hist = chartDataHistory[m.k];
                const timeStr = new Date().toLocaleTimeString();
                hist.labels.push(timeStr);
                hist.data.push(displayValue);
                if (hist.labels.length > 30) { hist.labels.shift(); hist.data.shift(); }

                if (activeChartMetric && activeChartMetric.k === m.k && chartInstance) {
                  chartInstance.update('none');
                }

                if (recordingCsv) {
                  const mLabel = currentMarker ? currentMarker : '';
                  csvBuf += `${new Date().toISOString()};${m.t};${displayValue.toFixed(2)};${unitConversions[m.k] && m.u === 'кПа' ? 'bar' : m.u};${mLabel}\n`;
                }
              }
            } catch (err) {}
          });
        }
      }
      if (currentMarker) currentMarker = ''; // Сброс маркера после записи
      if (action === 'read') { action = null; await readDTC(); }
      else if (action === 'clear') { action = null; if(!isDemoMode) await send('04', 5000); $('#dtc').textContent = 'Коды стёрты.'; devLog('Коды ошибок стёрты'); }
      
      await sleep(15); 
    }
  } catch (e) { 
    status('Ошибка: ' + errText(e)); 
    devLog('Сбой главного цикла: ' + errText(e), true);
  }
  running = false; 
  isDemoMode = false;
  buttons();
}

async function connect() {
  if (!navigator.bluetooth) { status('Web Bluetooth недоступен. Используйте Bluefy.'); devLog('Web Bluetooth не поддерживается', true); return; }
  try {
    devLog('Запрос Bluetooth устройства...');
    const dev = await navigator.bluetooth.requestDevice({acceptAllDevices: true, optionalServices: SERVICES});
    dev.addEventListener('gattserverdisconnected', () => { 
      running = false; 
      status('Адаптер отключился.'); 
      devLog('Bluetooth связь потеряна', true);
      buttons(); 
    });
    devLog('Выбрано устройство: ' + dev.name);
    status('Подключение к GATT...');
    const srv = await dev.gatt.connect();
    devLog('GATT подключен успешно');
    const notifs = [], writes = [];
    for (const s of await srv.getPrimaryServices()) {
      for (const c of await s.getCharacteristics()) {
        const p = c.properties;
        if (p.notify || p.indicate) notifs.push(c);
        if (p.write || p.writeWithoutResponse) writes.push(c);
      }
    }
    const pick = (arr, keys) => { for (const k of keys) { const f = arr.find(c => c.uuid.toLowerCase().includes(k)); if (f) return f; } return arr[0]; };
    wch = pick(writes, ['8841', 'fff2', 'ffe1', 'bef8d6c9']);
    nch = pick(notifs, ['1e4d', 'fff1', 'ffe1', 'bef8d6c9']);
    if (!nch || !wch) throw new Error('Не найден UART канал ELM327');
    for (const c of notifs) { try { await c.startNotifications(); c.addEventListener('characteristicvaluechanged', onData); } catch (e) {} }
    runMainLoop();
  } catch (e) { 
    status('Ошибка: ' + errText(e)); 
    devLog('Ошибка подключения: ' + errText(e), true);
  }
}

$('#bConn').onclick = connect;
$('#bDemo').onclick = () => { isDemoMode = true; runMainLoop(); };
$('#bStop').onclick = () => { running = false; isDemoMode = false; devLog('Остановлено пользователем'); };
$('#bMarker').onclick = () => { currentMarker = 'USER_MARKER'; devLog('МЕТКА: Поставлен пользовательский маркер в CSV'); };
$('#bRead').onclick = () => { action = 'read'; };
$('#bClear').onclick = () => { if (confirm('Стереть ошибки?')) action = 'clear'; };
$('#bLog').onclick = saveLog;
$('#bCsv').onclick = saveCsv;
$('#bScan').onclick = async () => { devLog('Сканирование CAN блоков...'); $('#mods').textContent = 'Сканер CAN активен.'; };
$('#tSend').onclick = async () => { 
  const v = $('#tIn').value.trim(); 
  if (v) { 
    $('#tOut').textContent += '> ' + v + '\n';
    try {
      const res = await send(v);
      $('#tOut').textContent += res.join('\n') + '\n';
    } catch(err) {
      $('#tOut').textContent += '! ' + errText(err) + '\n';
    }
    $('#tIn').value=''; 
  } 
};

devLog('Приложение готово к диагностике.');
buttons();
})();
